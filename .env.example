[TEMPLATE]
# ChaosHome environment template.
# Copy this file to `.env` and fill in real values. `.env` is gitignored, so
# your secrets never get committed. Never put real keys in this file.

# Free Gemini API key from https://aistudio.google.com/apikey
# Powers the online brain for the web dashboard and the Alexa skill.
GEMINI_API_KEY=

# Gemini model to use (fast, voice-friendly default).
GEMINI_MODEL=gemini-3.1-flash-lite

# How much Gemini 3.x may "think" before answering, in tokens.
# Default 0 (thinking off) because it is the biggest latency lever we measured:
# thinking on = 30s+ per dashboard chat turn, thinking off = ~3s. Raise it
# (e.g. 1024) only when you want deeper reasoning and can afford to wait.
# GEMINI_THINKING_BUDGET=0

# Optional: AWS Bedrock (alternative online brain). Leave blank to use Gemini.
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Force the agent offline (rules-based, no cloud) for testing: 1 = offline.
# CHAOSHOME_OFFLINE=1
